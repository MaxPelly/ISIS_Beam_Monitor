[DATA]
mcr_news_url = https://www.isis.stfc.ac.uk/gallery/beam-status/mcrnews.txt
isis_websocket_url = wss://ndaextweb4.nd.rl.ac.uk/pvws/pv
# Optional link shown as an "Open MCR news" button on MCR notification cards.
# mcr_page_url = https://www.isis.stfc.ac.uk/gallery/beam-status/

[WEBHOOKS]
# Webhook URLs should be kept secret. Consider restricting permissions on this file (e.g. chmod 600)
# to prevent other users from reading it. Leave a URL blank to disable that channel's Teams notifier.
news_teams_url =
beam_teams_url =
experiment_teams_url =

[PUSH]
# Optional: also POST every notification as HMAC-signed JSON to this URL, e.g. the
# push_site submodule (mobile push notifications). Leave blank to disable.
# url = http://127.0.0.1:8765/ingest
# File holding the shared secret (at least 32 characters, e.g. from
# `openssl rand -hex 32`); keep it chmod 600.
# secret_file = push.secret
# Seconds before each attempt is abandoned (0.5-30). Kept short because a slow
# receiver delays the Teams cards queued behind it (up to 3 attempts, 1s and
# 2s apart, or a Retry-After of at most 5s).
# timeout = 2

# One section per monitored instrument; run notifications for all of them go
# to experiment_teams_url, with the instrument name in the card title.
#   notify_counts  (required) the run's target, in total µA·h collected; the
#                  "run about to finish" card is sent [NOTIFICATIONS]
#                  finish_warning_minutes before it's expected to be reached
#   beam_target    (optional) TS1, TS2 or Muon: the beam reported on run cards and
#                  checked before stall warnings (default: [PVS] instrument_target)
#   channel        (optional) Teams payload channel for this instrument's cards:
#                  experiment (default) = "Experiment Updates", or instrument =
#                  the instrument's name
# Progress is read from IN:<NAME>:DAE:TOTALUAMPS and the run name from
# IN:<NAME>:DAE:WDTITLE, both derived from the name.
# Instruments and [NOTIFICATIONS] can also be edited from the TUI (press c); saving
# there rewrites this file without its comments (the old file is kept as .bak).
[INSTRUMENT:PEARL]
notify_counts = 130

# [INSTRUMENT:WISH]
# notify_counts = 200
# beam_target = TS2
# channel = instrument

[PVS]
# Default beam_target for instrument sections that don't set one (TS1, TS2 or Muon).
# instrument_target = TS1

[TUI]
# Number of samples the TUI shows per beam target (1-1000, default = 60 → 1-hour rolling window).
# history_maxlen = 60
# Interval in seconds between graph samples (1-3600, default = 60).
# sample_interval = 60
# Refresh rate for the UI (default = 4).
# refresh_per_second = 4
# Maximum number of log lines to show in the TUI (default = 50).
# logs_maxlen = 50

[DAEMON]
# Relative paths here and in [LOGGING] and [PUSH] are relative to this file's directory.
# SQLite database path for persisted history/state.
# db_path = beam_monitor.db
# Unix domain socket the TUI and `stop` connect to. Keep it out of shared
# directories such as /tmp, where another user could create it first.
# socket_path = isis_beam_monitor.sock
# Single-instance lock file for daemon mode.
# lock_file = isis_beam_monitor.lock
# Beam history retention window in days (1-365, but at most 100,000 samples per beam
# are kept in memory, so about 69 days at the default 60s sample_interval).
# retention_days = 7

[TUI_CLIENT]
# Reconnect backoff start and max in seconds.
# reconnect_initial = 1
# reconnect_max = 15

[LOGGING]
# log_file = monitor.log
# log_level = INFO
# log_max_bytes = 5000000
# log_backup_count = 3
# (both at least 1: a 0 in either would stop the log rotating)

[TIMEOUTS_INTERVALS]
# Seconds between MCR news polls (5-86400).
# mcr_poll_interval = 60.0
# Seconds before retrying a lost beam WebSocket (0.5-3600).
# beam_reconnect_interval = 5.0
# Seconds before a Teams webhook send is abandoned (1-300).
# webhook_timeout = 10.0

[BEAM_BOUNDARIES]
# Defined as 'off_limit, low_limit, medium_limit' in microamps
# ts1_boundaries = 0.0, 50.0, 140.0
# ts2_boundaries = 0.0, 10.0, 30.0
# muon_boundaries = 0.0, 2.0, 5.0

[NOTIFICATIONS]
# Adds optional personality lines to notification cards (off by default —
# emoji and severity colours are always shown regardless of this setting).
# fun_mode = false
# Timezone for card timestamps and for summary_time.
# timezone = Europe/London
# How long a beam state change must persist before a card is sent, in
# seconds (0-3600). Filters out brief flickers rather than reporting every one.
# debounce_seconds = 20
# How many minutes the µA·h collected can stay flat, while the instrument's
# beam is on, before a stall warning is sent (at most 10080, i.e. 7 days).
# stall_minutes = 15
# How many minutes before a run is expected to reach its notify_counts the
# "run about to finish" card is sent (0-10080; 0 = only once it's passed).
# finish_warning_minutes = 15
# Time (HH:MM, in the timezone above) the daily beam-uptime summary is sent at.
# summary_time = 08:00
